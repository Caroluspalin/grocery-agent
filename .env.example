# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä commitoi .env-tiedostoa.

# Anthropic API -avain: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Agentin käyttämä malli
ANTHROPIC_MODEL=claude-opus-5-5

# SQLite-tietokannan polku projektin juuresta
DATABASE_PATH=data/ruokakauppa.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
