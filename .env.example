# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä commitoi .env-tiedostoa.

# OpenAI API -avain: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Agentin käyttämä malli (pakollinen), esim. gpt-4.1-mini. Mallin pitää tukea
# function callingia.
MODEL=

# SQLite-tietokannan polku projektin juuresta
DATABASE_PATH=data/ruokakauppa.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
