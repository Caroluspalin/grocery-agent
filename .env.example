# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä commitoi .env-tiedostoa.

# OpenAI API -avain: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Agentin käyttämä malli (pakollinen), esim. gpt-4.1-mini. Mallin pitää tukea
# function callingia.
MODEL=

# Valinnainen: päättelymallien reasoning_effort (none, low, medium, high).
# Jätä tyhjäksi malleille, jotka eivät tue sitä (esim. gpt-4.1-mini). Osa
# päättelymalleista vaatii arvon none, jotta työkalut toimivat Chat Completionsissa.
REASONING_EFFORT=

# SQLite-tietokannan polku projektin juuresta
DATABASE_PATH=data/ruokakauppa.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
